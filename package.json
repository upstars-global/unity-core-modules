{
  "name": "unity-core-modules",
  "version": "1.123.1",
  "description": "",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/upstars-global/unity-core-modules.git"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint",
    "lint:tsc": "tsc --noEmit",
    "prepare": "husky",
    "ci": "find . -type d -name \"node_modules\" -prune -exec rm -rf {} + && yarn cache clean && yarn",
    "depcruise:test": "depcruise src --include-only '^src'",
    "depcruise:svg": "depcruise --include-only '^src' --output-type dot src | dot -T svg > dependencygraph.svg",
    "depcruise:check": "node scripts/depcruise-threshold.mjs --config=.dependency-cruiser.cjs --maxErrors=0 --maxWarnings=99",
    "ai:agents-md": "node ai-kit/scripts/sync-agents-md.mjs",
    "graph": "node scripts/ai.mjs graph-ui"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,mts,tsx}": "eslint --fix"
  },
  "private": true,
  "dependencies": {
    "@smartico/public-api": "0.0.450",
    "buffer": "^6.0.3",
    "centrifuge": "^5.8.0",
    "dayjs": "^1.11.23",
    "parse5": "^8.1.1",
    "pinia": "^3.0.4",
    "recaptcha-v3": "^1.11.3",
    "tiny-emitter": "^2.1.0",
    "typescript": "^5.9.3",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "vue": "^3.5.45",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "codebase-memory-mcp": "0.12.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "dependency-cruiser": "^18.7.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "unity-eslint-config": "upstars-global/unity-eslint-config#v1.0.1",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}